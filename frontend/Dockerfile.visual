# Canonical screenshot environment; browser and Node images are both pinned.
FROM node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0 AS node-runtime
FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /work/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN node --version && npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/index.html frontend/tsconfig.json frontend/tsconfig.test.json frontend/eslint.config.mjs frontend/playwright.config.ts ./
COPY frontend/src/ src/
COPY frontend/public/andeiva-logo.png frontend/public/theme-init.js public/
COPY frontend/tests/ tests/
COPY frontend/scripts/ scripts/
COPY frontend/e2e/ e2e/
RUN npm run lint && npm test && npm run build
CMD ["npm", "run", "test:e2e"]
