[Unit]
Description=ANDEIVA explicitly prepared grouped runtime supervisor
Wants=andeiva-preview-grouped.socket
# Losing the management socket must not stop the guardian parent.
After=andeiva-preview-grouped.socket
ConditionPathExists=/etc/andeiva-preview/grouped.json
ConditionPathExists=/etc/andeiva-preview/grouped-links.json
ConditionPathExists=/var/lib/andeiva-preview/grouped-cutover.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# Root owns only the inherited-resource supervisor. It launches an API without
# capabilities and a namespace-bound helper with NET_ADMIN through fixed roles.
Type=simple
NotifyAccess=main
FileDescriptorStoreMax=7
FileDescriptorStorePreserve=yes
User=root
Group=root
ExecStart=/usr/lib/andeiva-preview/andeiva-preview grouped-managed-supervisor
Restart=no
OOMPolicy=continue
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=control-group
Delegate=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_DAC_READ_SEARCH CAP_KILL CAP_CHOWN
RuntimeDirectory=andeiva-preview/grouped
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# /proc/sys/net must resolve in the executing namespace, never a bind-mounted
# host net subtree. Every write uses the fixed namespace-bound executor.
ProtectKernelTunables=no
ReadOnlyPaths=/proc/sys/kernel /proc/sys/vm /proc/sys/fs /proc/sys/dev
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/andeiva-preview/grouped /var/lib/andeiva-preview/audit /run/andeiva-preview/grouped
ReadWritePaths=/var/lib/andeiva-preview-package/grouped-retirement-v3 /var/lib/andeiva-preview-package/grouped-scope-v3
InaccessiblePaths=-/var/lib/andeiva-preview/operator
TasksMax=128
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
# No Install section: packaging never enables this incomplete deployment path.
# Cold activation, recovery and installed resource gates remain mandatory.
