[Unit]
Description=ANDEIVA preview isolated policy helper
PartOf=andeiva-preview.target
Requires=andeiva-preview-namespaces.service
After=andeiva-preview-namespaces.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=andeiva-preview-helper
Group=andeiva-preview-ipc
NetworkNamespacePath=/run/andeiva-preview/netns/gateway
RuntimeDirectory=andeiva-preview-helper
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/andeiva-preview/andeiva-preview helper
ExecStopPost=+/usr/bin/systemctl --no-block stop andeiva-preview.target
Restart=no
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
InaccessiblePaths=-/var/lib/andeiva-preview/state -/var/lib/andeiva-preview/audit -/var/lib/andeiva-preview/operator -/var/lib/andeiva-preview/server.key -/var/lib/andeiva-preview/accounts.json
MemoryMax=96M
TasksMax=64
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
