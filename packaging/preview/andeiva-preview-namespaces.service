[Unit]
ConditionPathExists=!/var/lib/andeiva-preview/grouped-cutover.json
Description=ANDEIVA preview isolated namespace lifecycle
PartOf=andeiva-preview.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
# Use the system manager's root identity with the bounded capabilities below.
# This setup process must retain SETUID to drop its traffic children to their UID.
Group=root
RuntimeDirectory=andeiva-preview
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/lib/andeiva-preview/andeiva-preview namespaces
ExecStopPost=/usr/bin/systemctl --no-block stop andeiva-preview.target
Restart=no
TimeoutStartSec=45
TimeoutStopSec=20
KillMode=control-group
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
PrivateTmp=no
PrivateMounts=no
ProtectSystem=no
ProtectHome=no
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryMax=192M
TasksMax=96
LimitNOFILE=512
StandardOutput=journal
StandardError=journal
