[Unit]
Description=ANDEIVA experimental liveness service
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
DynamicUser=yes
User=andeiva-api
RuntimeDirectory=andeiva-api
RuntimeDirectoryMode=0750
WorkingDirectory=/run/andeiva-api
EnvironmentFile=/etc/andeiva/andeiva-api.env
Environment=GOMAXPROCS=1 GOMEMLIMIT=96MiB
ExecStart=/usr/lib/andeiva/andeiva-api
ExecStartPost=/usr/lib/andeiva/wait-ready
Restart=on-failure
RestartSec=2s
TimeoutStartSec=10s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
CPUQuota=100%
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=andeiva-api

[Install]
WantedBy=multi-user.target
