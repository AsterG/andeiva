# Development resolver only; never an appliance runtime image.
FROM debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
    && apt-get install --assume-yes --no-install-recommends ca-certificates gpg gpg-agent shellcheck \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
ENV HOME=/tmp GOCACHE=/tmp/go-cache
